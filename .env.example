# Copy to .env and customize for your setup

# Path to STL files (file browser root)
ORCA_MODELS_PATH=/data/models

# Path for sliced output files
ORCA_SLICED_PATH=/data/output

# Path to OrcaSlicer profiles
ORCA_PROFILES_PATH=/opt/orcaslicer/profiles

# OrcaSlicer binary path
ORCA_ORCASLICER_BIN=/usr/local/bin/orcaslicer

# OpenSCAD binary path (used for SCAD-to-STL export)
ORCA_OPENSCAD_BIN=/usr/bin/openscad

# Jobs database file path
ORCA_JOBS_FILE=./data/jobs.json

# API settings (optional)
# ORCA_API_HOST=0.0.0.0
# ORCA_API_PORT=8000
# ORCA_DEBUG=false
